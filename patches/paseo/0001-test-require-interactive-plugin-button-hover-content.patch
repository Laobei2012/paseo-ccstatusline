@@ -47,6 +47,85 @@ function button(onPress = () => {}): PluginButton {
 }
 
 describe("plugin buttons", () => {
+  it("keeps hover content on presentation updates and dismisses it for press, replacement and removal", async () => {
+    const buttons = store();
+    const plugin = installation();
+    const Content = () => null;
+    const registration = buttons.addComposerPill(plugin, {
+      id: "preview",
+      workspaceId: "workspace",
+      agentId: "agent",
+      button: { ...button(), hover: { Content } },
+    });
+    const key = buttons.getSnapshot()[0].key;
+    buttons.setHoverOpen(key, true);
+    expect(buttons.getSnapshot()[0].hoverOpen).toBe(true);
+    registration.update({ title: "Updated", label: "42%" });
+    expect(buttons.getSnapshot()[0].hoverOpen).toBe(true);
+    registration.update({ hover: { Content } });
+    expect(buttons.getSnapshot()[0].hoverOpen).toBe(true);
+    buttons.setOpen(key, true);
+    expect(buttons.getSnapshot()[0].hoverOpen).toBe(false);
+    buttons.setHoverOpen(key, true);
+    expect(buttons.getSnapshot()[0].hoverOpen).toBe(false);
+    buttons.setOpen(key, false);
+    buttons.setHoverOpen(key, true);
+    await buttons.run(key);
+    expect(buttons.getSnapshot()[0].hoverOpen).toBe(false);
+    buttons.setHoverOpen(key, true);
+    registration.update({ hover: { Content: () => null } });
+    expect(buttons.getSnapshot()[0].hoverOpen).toBe(false);
+    buttons.setHoverOpen(key, true);
+    registration.update({ disabled: true });
+    expect(buttons.getSnapshot()[0].hoverOpen).toBe(false);
+    buttons.setHoverOpen(key, true);
+    expect(buttons.getSnapshot()[0].hoverOpen).toBe(false);
+    registration.update({ disabled: false });
+    buttons.setHoverOpen(key, true);
+    registration.update({ visible: false });
+    expect(buttons.getSnapshot()[0].hoverOpen).toBe(false);
+    registration.update({ visible: true });
+    buttons.setHoverOpen(key, true);
+    registration.update({ hover: undefined });
+    expect(buttons.getSnapshot()[0].hoverOpen).toBe(false);
+    buttons.setHoverOpen(key, true);
+    expect(buttons.getSnapshot()[0].hoverOpen).toBe(false);
+    registration.remove();
+    buttons.setHoverOpen(key, true);
+    expect(buttons.getSnapshot()).toEqual([]);
+  });
+
+  it("rejects invalid hover components on registration and update without changing existing content", () => {
+    const buttons = store();
+    const plugin = installation();
+    const hover = { Content: () => null };
+    const registration = buttons.addHeaderButton(plugin, {
+      id: "preview",
+      workspaceId: "workspace",
+      button: { ...button(), hover },
+    });
+    const key = buttons.getSnapshot()[0].key;
+    buttons.setHoverOpen(key, true);
+    const invalid = { Content: () => null };
+    Reflect.set(invalid, "Content", 42);
+    expect(() => registration.update({ title: "Bad", hover: invalid })).toThrow(
+      "Plugin button hover needs Content",
+    );
+    expect(buttons.getSnapshot()[0].button.title).toBe("Review");
+    expect(buttons.getSnapshot()[0].button.hover?.Content).toBe(hover.Content);
+    expect(buttons.getSnapshot()[0].hoverOpen).toBe(true);
+    expect(() =>
+      buttons.addHeaderButton(plugin, {
+        id: "invalid",
+        workspaceId: "workspace",
+        button: { ...button(), hover: invalid },
+      }),
+    ).toThrow("Plugin button hover needs Content");
+    registration.update({ label: "Still valid" });
+    expect(buttons.getSnapshot()[0].button.hover?.Content).toBe(hover.Content);
+    registration.remove();
+  });
+
