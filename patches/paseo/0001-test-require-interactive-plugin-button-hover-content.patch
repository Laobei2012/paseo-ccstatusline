+function Preview({ workspaceId, agentId, host, theme, close }) {
+  const workspace = useWorkspace(workspaceId, (workspace) => workspace.name);
+  const [count, setCount] = React.useState(0);
+  const [failed, setFailed] = React.useState(false);
+  if (failed) throw new Error("Preview content failed");
+  return <View style={{ gap: 12 }}>
+    <Text style={{ color: theme.colors.foreground }}>Preview workspace: {workspace}</Text>
+    <Text style={{ color: theme.colors.foreground }}>Preview agent: {agentId}</Text>
+    <Text style={{ color: theme.colors.foreground }}>Preview host: {host.id}</Text>
+    <Text style={{ color: theme.colors.foreground }}>Preview count: {count}</Text>
+    <Pressable accessibilityRole="button" accessibilityLabel="Update preview" onPress={() => { setCount((n) => n + 1); updatePreview(); }}>
+      <Text style={{ color: theme.colors.foreground }}>Update preview</Text>
+    </Pressable>
+    <Pressable accessibilityRole="button" accessibilityLabel="Close preview" onPress={close}><Text style={{ color: theme.colors.foreground }}>Close preview</Text></Pressable>
+    <Pressable accessibilityRole="button" accessibilityLabel="Fail preview" onPress={() => setFailed(true)}><Text style={{ color: theme.colors.foreground }}>Fail preview</Text></Pressable>
+  </View>;
+}
