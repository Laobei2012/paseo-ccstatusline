diff --git a/packages/client/src/index.test.ts b/packages/client/src/index.test.ts
index 1b11a3032..0a90131a1 100644
--- a/packages/client/src/index.test.ts
+++ b/packages/client/src/index.test.ts
@@ -1508,6 +1508,45 @@ test("provider usage requires the advertised host capability", async () => {
   await client.close();
 });
 
+test("agent usage reports preserve daemon attribution and account metadata", async () => {
+  const { client, ws } = await connectClient({ usageSources: true });
+  const result = client.providers.listUsageReports({ agentId: "agent-a", requestId: "scoped" });
+  expect(parseSentSessionMessage(ws.sent.at(-1))).toMatchObject({
+    type: "usage.list_reports.request",
+    agentId: "agent-a",
+    requestId: "scoped",
+  });
+  const report = {
+    id: "codex:account-a",
+    sourceId: "codex",
+    sourceLabel: "Codex",
+    account: { label: "Account A" },
+    fetchedAt: "2026-10-31T00:00:00.000Z",
+    report: { status: "available", windows: [{ id: "five_hour", label: "Session", usedPct: 42 }] },
+  };
+  ws.message(
+    sessionMessage({ type: "usage.list_reports.update", payload: { requestId: "scoped", report } }),
+  );
+  ws.message(
+    sessionMessage({
+      type: "usage.list_reports.response",
+      payload: { requestId: "scoped", error: null },
+    }),
+  );
+  await expect(result).resolves.toEqual({ requestId: "scoped", reports: [report] });
+  await client.close();
+});
+
+test("agent usage reports stay empty on legacy hosts without agent attribution", async () => {
+  const { client, ws } = await connectClient({ providerUsageList: true });
+  const count = ws.sent.length;
+  await expect(client.providers.listUsageReports({ agentId: "agent-a" })).resolves.toMatchObject({
+    reports: [],
+  });
+  expect(ws.sent).toHaveLength(count);
+  await client.close();
+});
+
 test("config actions delegate to existing daemon config RPCs", async () => {
   const { client, ws } = await connectClient();
 
